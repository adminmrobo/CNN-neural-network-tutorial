  {
   "id": "lab:method/cnn",
   "type": "Method",
   "label": {
    "ko": "합성곱 신경망 (CNN)",
    "en": "Convolutional neural network"
   },
   "anchor": "#stage",
   "level": 2,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
    "ko": "3×3 필터를 그림 위로 미끄러뜨려 특징 지도를 만들고, 최댓값으로 줄인 뒤 분류하는 망. 이 실험은 필터 4개 → 2×2 최댓값 줄이기 → 필터 8개 → 지도마다 최댓값 → 3."
   },
   "family": "vision"
  },
  {
   "id": "lab:concept/convolution-filter",
   "type": "Concept",
   "label": {
    "ko": "필터 미끄러뜨리기 (합성곱)",
    "en": "Sliding a filter (convolution)"
   },
   "anchor": "#stage",
   "level": 2,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
    "ko": "같은 3×3 숫자 묶음을 그림의 모든 위치에 곱해 더하는 일."
   },
   "family": "vision"
  },
  {
   "id": "lab:concept/weight-sharing",
   "type": "Concept",
   "label": {
    "ko": "가중치 공유",
    "en": "Weight sharing"
   },
   "anchor": "#stage",
   "level": 2,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
    "ko": "같은 필터 숫자를 그림 전체에 나눠 써서 가중치가 363개뿐(일반 망 8,323개, 23배 적음)."
   },
   "family": "vision"
  },
  {
   "id": "lab:concept/feature-map",
   "type": "Concept",
   "label": {
    "ko": "특징 지도",
    "en": "Feature map"
   },
   "anchor": "#stage",
   "level": 2,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
    "ko": "필터 하나가 그림 전체를 훑은 결과. 필터 4개면 지도 4장."
   },
   "family": "vision"
  },
  {
   "id": "lab:concept/max-pooling",
   "type": "Concept",
   "label": {
    "ko": "최댓값 줄이기 (최대 풀링)",
    "en": "Max pooling"
   },
   "anchor": "#stage",
   "level": 2,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
    "ko": "2×2 칸에서 가장 큰 값만 남기고, 마지막에는 지도마다 가장 큰 값 하나만 남긴다."
   },
   "family": "vision"
  },
  {
   "id": "lab:concept/translation-invariance",
   "type": "Concept",
   "label": {
    "ko": "옮겨도 알아보기 (이동 불변성)",
    "en": "Shift invariance"
   },
   "anchor": "#stage",
   "level": 3,
   "status": "known",
   "confidence": "high",
   "coverage": "explained",
   "domain": [
    "dl"
   ],
   "match": [],
   "definition": {
